# Required: use your resource endpoints and Claude deployment name.
FOUNDRY_BASE_URL='https://<foundry-resource>.services.ai.azure.com/anthropic'
CLAUDE_DEPLOYMENT='<claude-deployment>'
# A Content Safety resource, or a Foundry (AI Services) resource in a supported region.
CONTENT_SAFETY_ENDPOINT='https://<content-safety-or-foundry-resource>.cognitiveservices.azure.com'

# Optional: leave empty to use Microsoft Entra ID.
FOUNDRY_API_KEY=''
CONTENT_SAFETY_KEY=''

# Optional: the values below match the script defaults.
CONTENT_SAFETY_API_VERSION=2024-09-01
# Block when any harm category reaches this severity: 2 (low), 4 (medium), or 6 (high).
HARM_SEVERITY_THRESHOLD=4
PROMPT_SHIELDS=true
PROTECTED_MATERIAL=true
# Comma-separated names of blocklists already created on the Content Safety resource.
BLOCKLIST_NAMES=''

# Optional: set LANGUAGE_ENDPOINT to also run the 2b PII screen. The other PII settings match 2b.
LANGUAGE_ENDPOINT=''
LANGUAGE_KEY=''
INPUT_PII_MODE=block
OUTPUT_PII_MODE=redact
PII_API_VERSION=2025-11-15-preview
PII_POLICY=entityMask
PII_LANGUAGE=en
PII_MIN_CONFIDENCE=0.8
PII_CATEGORIES=''

# Optional: set to 1.2 only if your network breaks TLS 1.3 (SSL UNEXPECTED_EOF errors).
TLS_MAX_VERSION=''
