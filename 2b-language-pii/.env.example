# Required: use your resource endpoints and Claude deployment name.
FOUNDRY_BASE_URL='https://<foundry-resource>.services.ai.azure.com/anthropic'
CLAUDE_DEPLOYMENT='<claude-deployment>'
LANGUAGE_ENDPOINT='https://<language-resource>.cognitiveservices.azure.com'

# Optional: leave empty to use Microsoft Entra ID.
FOUNDRY_API_KEY=''
LANGUAGE_KEY=''

# Optional: the values below match the script defaults.
INPUT_PII_MODE=block
OUTPUT_PII_MODE=redact
PII_API_VERSION=2025-11-15-preview
# Redaction policy: entityMask, characterMask, or syntheticReplacement.
PII_POLICY=entityMask
PII_LANGUAGE=en
PII_MIN_CONFIDENCE=0.8
# Leave empty for all supported categories, or set e.g. Email,PhoneNumber.
PII_CATEGORIES=''

# Optional: set to 1.2 only if your network breaks TLS 1.3 (SSL UNEXPECTED_EOF errors).
TLS_MAX_VERSION=''
